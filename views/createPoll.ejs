<!doctype html>
<html lang="en"><head><%- include('partials/head', { title: 'AAU Forum - Create Poll' }) %></head>
<body class="app-page"><%- include('partials/header', { active: 'polls' }) %><main class="content narrow-content"><a class="back-link" href="/Polls">Back to polls</a><section class="form-card"><p class="eyebrow">Ask the community</p><h1>Create Poll</h1><% if (error) { %><p class="error-message"><%= error %></p><% } %><form class="stack-form" method="POST" action="/addPoll"><label>Poll Title<input name="title" placeholder="Example: Which study room works best?" required></label><label>Description<textarea name="description" placeholder="Add context for your poll..."></textarea></label><label>Deadline for voting <span class="hint" title="Voting closes at this date and time.">ⓘ</span><input name="dateFor" type="datetime-local" required></label><label>Tags<input name="tags" placeholder="study, javascript, tutoring"></label><label>Options<input name="options" placeholder="Monday, Wednesday, Friday" required></label><button class="button" type="submit">Create Poll</button></form></section></main><%- include('partials/footer') %></body></html>
