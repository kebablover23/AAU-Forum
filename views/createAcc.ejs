<!doctype html>
<html lang="en"><head><%- include('partials/head', { title: 'AAU Forum - Create Account' }) %></head>
<body class="auth-page"><%- include('partials/header', { active: '' }) %><main class="auth-main"><section class="form-card"><p class="eyebrow">Get started</p><h1>Create Account</h1><p class="muted">Use a UserID for this prototype account.</p><% if (error) { %><p class="error-message"><%= error %></p><% } %><form class="stack-form" method="POST" action="/register" enctype="multipart/form-data"><label>UserID<input name="Userid" value="<%= form?.Userid || '' %>" required></label><label>Name<input name="username" placeholder="Your name" value="<%= form?.username || '' %>" required></label><label>Role<select name="semester" required><option value="">Select your role</option><%- include('partials/roles', { selected: form?.semester }) %></select></label><label>Profile Picture<input type="file" name="profilePic" accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp"></label><button class="button" type="submit">Create Account</button></form><p class="form-footer">Already registered? <a href="/login">Login</a></p></section></main><%- include('partials/footer') %></body></html>
