<!doctype html>
<html lang="en"><head><%- include('partials/head', { title: 'AAU Forum - Messages' }) %></head>
<body class="app-page" data-user-id="<%= currentUser._id %>" data-room-type="conversation" data-room-id="<%= conversation?._id || '' %>"><%- include('partials/header', { active: 'messages' }) %><main class="messages-layout"><aside class="conversation-panel"><form class="new-chat" action="/createConversation" method="POST"><label class="sr-only" for="user2">Select user</label><select id="user2" name="user2" required><option value="">Select user</option><% users.forEach(user => { if (user._id.toString() !== currentUser._id.toString()) { %><option value="<%= user._id %>"><%= user.username %></option><% } }) %></select><button class="button" type="submit">New Chat</button></form><% if (error) { %><p class="error-message"><%= error %></p><% } %><div class="conversation-list"><% (conversations || []).forEach(item => { const other = item.participants.find(user => user._id.toString() !== currentUser._id.toString()); const last = item.messages[item.messages.length - 1]; %><a class="conversation-row <%= conversation?._id?.toString() === item._id.toString() ? 'active' : '' %>" href="/Messages/<%= item._id %>"><img class="avatar" src="<%= other?.profilePic || '/images/default.png' %>" alt=""><span><strong><%= other?.username || 'Unknown user' %></strong><small><%= last?.text || 'Start chatting...' %></small></span></a><% }) %></div></aside><section class="chat-panel"><% if (conversation) { const other = conversation.participants.find(user => user._id.toString() !== currentUser._id.toString()); %><div class="chat-heading"><img class="avatar" src="<%= other?.profilePic || '/images/default.png' %>" alt=""><h1><%= other?.username || 'Unknown user' %></h1></div><div class="chat-messages" id="chatMessages" data-conversation-id="<%= conversation._id %>" data-user-id="<%= currentUser._id %>"><% if (conversation.messages.length === 0) { %><div class="empty-state"><p>No messages yet</p><small>Start chatting...</small></div><% } %><% conversation.messages.forEach(message => { %><div class="message <%= message.sender._id.toString() === currentUser._id.toString() ? 'sent' : 'received' %>"><div class="message-bubble"><span class="message-text"><%= message.text %></span></div></div><% }) %></div><form class="chat-input" action="/Messages/sendMessage" method="POST"><input type="hidden" name="conversationId" value="<%= conversation._id %>"><input name="text" placeholder="Message..." autocomplete="off" required><button class="button" type="submit" aria-label="Send message">Send</button></form><% } else { %><div class="empty-state chat-empty"><h2>Your messages</h2><p>Select a user to start chatting.</p></div><% } %></section></main><%- include('partials/footer') %></body></html>
