<!doctype html>
<html lang="en"><head><%- include('partials/head', { title: 'AAU Forum - Create Post' }) %></head>
<body class="app-page"><%- include('partials/header', { active: 'home' }) %><main class="content narrow-content"><a class="back-link" href="/">Back to posts</a><section class="form-card"><p class="eyebrow">Share with the community</p><h1>Create Post</h1><% if (error) { %><p class="error-message"><%= error %></p><% } %><form class="stack-form" method="POST" action="/addTP"><label>Title<input name="title" placeholder="What would you like to post?" required></label><label>Description<textarea name="description" placeholder="Write your post..." required></textarea></label><label>Tags (separate by commas)<input name="tags" placeholder="study, javascript, tutoring"></label><button class="button" type="submit">Post</button></form></section></main><%- include('partials/footer') %></body></html>
