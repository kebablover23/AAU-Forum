<!doctype html>
<html lang="en"><head><%- include('partials/head', { title: 'AAU Forum - Events' }) %></head>
<body class="app-page" data-user-id="<%= currentUser?._id || '' %>"><%- include('partials/header', { active: 'events' }) %><main class="content"><div class="page-header"><div><p class="eyebrow">Campus activities</p><h1>Events</h1></div><a class="button" href="/createEvent">Create Event</a></div><section class="feed"><% if (!events || events.length === 0) { %><div class="empty-state"><h2>No events found</h2><p>Create an event for your fellow students.</p></div><% } %><% (events || []).forEach(event => { const attending = event.attending?.some(user => user._id.toString() === currentUser?._id?.toString()); %><article class="event-card" data-event="<%= event._id %>"><a class="post-link" href="/Events/<%= event._id %>"><% if (event.picture) { %><img class="event-picture" src="<%= event.picture %>" alt="Event image"><% } %><div class="post-author"><a href="/profile/<%= event.userId?._id || '' %>"><img class="avatar" src="<%= event.userId?.profilePic || '/images/default.png' %>" alt=""></a><div><a href="/profile/<%= event.userId?._id || '' %>"><strong><%= event.userId?.username || 'Unknown user' %></strong></a><small><%= event.userId?.semester || '' %> · <%= formatDate(event.createdAt) %></small></div></div><h2><%= event.title %></h2><p><%= event.description %></p><div class="event-details"><span><strong>Date:</strong> <%= formatDate(event.dateFor) %></span><span><strong>Location:</strong> <%= event.location %></span><span><strong>Attending:</strong> <b data-attendee-count><%= event.attending?.length || 0 %></b></span></div><div class="tags"><% (event.tags || []).forEach(tag => { %><span class="tag"><%= tag %></span><% }) %></div></a><% if (currentUser) { %><form class="card-action" action="/attendEvent/<%= event._id %>" method="POST"><button class="button <%= attending ? 'button-secondary' : '' %>" type="submit"><%= attending ? 'Leave Event' : 'Attend' %></button></form><% } %></article><% }) %></section></main><%- include('partials/footer') %></body></html>
