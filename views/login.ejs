<!doctype html>
<html lang="en"><head><%- include('partials/head', { title: 'AAU Forum - Login' }) %></head>
<body class="auth-page"><%- include('partials/header', { active: '' }) %><main class="auth-main"><section class="form-card"><p class="eyebrow">AAU Forum</p><h1>Welcome back</h1><p class="muted">Log in with your unique UserID.</p><% if (error) { %><p class="error-message"><%= error %></p><% } %><form class="stack-form" method="POST" action="/login"><label>UserID<input name="Userid" value="<%= typeof Userid !== 'undefined' ? Userid : '' %>" autocomplete="username" required></label><button class="button" type="submit">Login</button></form><p class="form-footer">New here? <a href="/register">Create Account</a></p></section></main><%- include('partials/footer') %></body></html>
