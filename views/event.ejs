<!doctype html>
<html lang="en"><head><%- include('partials/head', { title: `AAU Forum - ${event.title}` }) %></head>
<body class="app-page" data-user-id="<%= currentUser?._id || '' %>" data-room-type="event" data-room-id="<%= event._id %>"><%- include('partials/header', { active: 'events' }) %><main class="content narrow-content"><a class="back-link" href="/Events">Back to events</a><article class="detail-card" data-event="<%= event._id %>"><% if (event.picture) { %><img class="detail-picture" src="<%= event.picture %>" alt="Event image"><% } %><div class="post-author"><a href="/profile/<%= event.userId?._id || '' %>"><img class="avatar" src="<%= event.userId?.profilePic || '/images/default.png' %>" alt=""></a><div><a href="/profile/<%= event.userId?._id || '' %>"><strong><%= event.userId?.username || 'Unknown user' %></strong></a><small><%= event.userId?.semester || '' %> · <%= formatDate(event.createdAt) %></small></div></div><h1><%= event.title %></h1><p class="detail-description"><%= event.description %></p><div class="event-details"><span><strong>Date:</strong> <%= formatDate(event.dateFor) %></span><span><strong>Location:</strong> <%= event.location %></span><span><strong>Attending:</strong> <b data-attendee-count><%= event.attending?.length || 0 %></b></span></div><div class="tags"><% (event.tags || []).forEach(tag => { %><span class="tag"><%= tag %></span><% }) %></div><% if (currentUser) { const attending = event.attending.some(user => user._id.toString() === currentUser._id.toString()); %><form class="detail-action" action="/attendEvent/<%= event._id %>" method="POST"><button class="button" type="submit"><%= attending ? 'Leave Event' : 'Attend' %></button></form><% } %><% if (currentUser && event.userId?._id?.toString() === currentUser._id.toString()) { %><form class="detail-action" action="/deleteEvent/<%= event._id %>" method="POST"><button class="button button-danger" type="submit">Delete Event</button></form><% } %></article><%- include('partials/comments', { item: event, type: 'event', redirectTo: `/Events/${event._id}` }) %></main><%- include('partials/footer') %></body></html>
