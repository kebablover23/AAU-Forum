<!doctype html>
<html lang="en"><head><%- include('partials/head', { title: 'AAU Forum - Polls' }) %></head>
<body class="app-page"><%- include('partials/header', { active: 'polls' }) %><main class="content"><div class="page-header"><div><p class="eyebrow">Community decisions</p><h1>Polls</h1></div><a class="button" href="/Polls/addPoll">Create Poll</a></div><section class="feed"><h2 class="section-title">Active Polls</h2><% if (!activePolls || activePolls.length === 0) { %><div class="empty-state"><p>No active polls right now.</p></div><% } %><% (activePolls || []).forEach(poll => { const total = poll.answers.reduce((sum, answer) => sum + answer.answered.length, 0); %><form class="poll-card" data-poll="<%= poll._id %>" data-room-type="poll" data-room-id="<%= poll._id %>" action="/votePoll/<%= poll._id %>" method="POST"><div class="post-author"><a href="/profile/<%= poll.userId?._id || '' %>"><img class="avatar" src="<%= poll.userId?.profilePic || '/images/default.png' %>" alt=""></a><div><a href="/profile/<%= poll.userId?._id || '' %>"><strong><%= poll.userId?.username || 'Unknown user' %></strong></a><small>Deadline: <%= formatDate(poll.dateFor) %></small></div></div><h2><%= poll.title %></h2><p><%= poll.description || '' %></p><p class="vote-summary" data-total-votes><%= total %> votes</p><div class="poll-options"><% poll.answers.forEach(answer => { const count = answer.answered.length; const percent = total ? Math.round(count / total * 100) : 0; %><label class="poll-option" data-answer="<%= answer._id %>"><input type="radio" name="answerId" value="<%= answer._id %>" required><span><%= answer.answer %></span><b><span data-vote-count><%= count %></span> · <%= percent %>%</b></label><div class="progress"><span style="width:<%= percent %>%"></span></div><% }) %></div><div class="tags"><% (poll.tags || []).forEach(tag => { %><span class="tag"><%= tag %></span><% }) %></div><button class="button" type="submit">Vote</button></form><% if (currentUser && poll.userId?._id?.toString() === currentUser._id.toString()) { %><form class="card-action" action="/deletePoll/<%= poll._id %>" method="POST"><button class="button button-danger" type="submit">Delete Poll</button></form><% } %><% }) %><button class="button button-secondary previous-toggle" type="button" data-previous-toggle aria-expanded="false">Previous Polls</button><div class="previous-polls hidden" data-previous-polls><h2 class="section-title">Previous Polls</h2><% (previousPolls || []).forEach(poll => { const total = poll.answers.reduce((sum, answer) => sum + answer.answered.length, 0); %><article class="poll-card previous"><h2><%= poll.title %></h2><p class="muted">Voting ended <%= formatDate(poll.dateFor) %> · <%= total %> votes</p><div class="poll-options"><% poll.answers.forEach(answer => { const percent = total ? Math.round(answer.answered.length / total * 100) : 0; %><div class="poll-option"><span><%= answer.answer %></span><b><%= answer.answered.length %> · <%= percent %>%</b></div><div class="progress"><span style="width:<%= percent %>%"></span></div><% }) %></div></article><% }) %><% if (!previousPolls || previousPolls.length === 0) { %><p class="muted">No previous polls.</p><% } %></div></section></main><%- include('partials/footer') %><script>document.querySelector('[data-previous-toggle]')?.addEventListener('click', event => { const section = document.querySelector('[data-previous-polls]'); const hidden = section.classList.toggle('hidden'); event.currentTarget.setAttribute('aria-expanded', String(!hidden)); event.currentTarget.textContent = hidden ? 'Previous Polls' : 'Hide Previous Polls'; });</script></body></html>
