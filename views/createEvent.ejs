<!doctype html>
<html lang="en"><head><%- include('partials/head', { title: 'AAU Forum - Create Event' }) %></head>
<body class="app-page"><%- include('partials/header', { active: 'events' }) %><main class="content narrow-content"><a class="back-link" href="/Events">Back to events</a><section class="form-card"><p class="eyebrow">Bring people together</p><h1>Create Event</h1><% if (error) { %><p class="error-message"><%= error %></p><% } %><form class="stack-form" method="POST" action="/createEvent" enctype="multipart/form-data"><label>Event Title<input name="title" placeholder="Example: JavaScript Study Session" required></label><label>Description<textarea name="description" placeholder="Describe the event..." required></textarea></label><label>Date &amp; Time<input name="dateFor" type="datetime-local" required></label><label>Location<input name="location" placeholder="Example: A. C. Meyers Vænge 15, room 2.123" required></label><label>Tags<input name="tags" placeholder="study, javascript, tutoring"></label><label>Event Picture<input name="picture" type="file" accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp"></label><button class="button" type="submit">Create Event</button></form></section></main><%- include('partials/footer') %></body></html>
