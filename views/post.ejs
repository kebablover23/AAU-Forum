<!doctype html>
<html lang="en"><head><%- include('partials/head', { title: `AAU Forum - ${post.title}` }) %></head>
<body class="app-page" data-user-id="<%= currentUser?._id || '' %>" data-room-type="post" data-room-id="<%= post._id %>"><%- include('partials/header', { active: 'home' }) %>
<main class="content narrow-content"><a class="back-link" href="/">Back to posts</a><article class="detail-card"><div class="post-author"><a href="/profile/<%= post.userId?._id || '' %>"><img class="avatar" src="<%= post.userId?.profilePic || '/images/default.png' %>" alt=""></a><div><a href="/profile/<%= post.userId?._id || '' %>"><strong><%= post.userId?.username || 'Unknown user' %></strong></a><small><%= post.userId?.semester || '' %> · <%= formatDate(post.createdAt) %></small></div></div><h1><%= post.title %></h1><p class="detail-description"><%= post.description %></p><div class="tags"><% (post.tags || []).forEach(tag => { %><span class="tag"><%= tag %></span><% }) %></div></article><%- include('partials/comments', { item: post, type: 'post', redirectTo: `/post/${post._id}` }) %></main><%- include('partials/footer') %></body></html>
