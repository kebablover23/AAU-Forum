<!doctype html>
<html lang="en"><head><%- include('partials/head', { title: `AAU Forum - ${profileUser.username}` }) %></head>
<body class="app-page"><%- include('partials/header', { active: '' }) %><main class="content narrow-content"><section class="detail-card profile-card"><img class="avatar avatar-large" src="<%= profileUser.profilePic || '/images/default.png' %>" alt="<%= profileUser.username %>'s profile picture"><h1><%= profileUser.username %></h1><p class="muted"><%= profileUser.semester %></p><p class="profile-bio"><%= profileUser.bio || 'No bio yet.' %></p></section><section class="detail-card profile-list"><h2>Posts</h2><% if (!posts.length) { %><p class="muted">No posts yet.</p><% } %><% posts.forEach(post => { %><a class="profile-item" href="/post/<%= post._id %>"><strong><%= post.title %></strong><small><%= formatDate(post.createdAt) %></small></a><% }) %></section><section class="detail-card profile-list"><h2>Events</h2><% if (!events.length) { %><p class="muted">No events yet.</p><% } %><% events.forEach(event => { %><a class="profile-item" href="/Events/<%= event._id %>"><strong><%= event.title %></strong><small><%= formatDate(event.dateFor) %></small></a><% }) %></section><section class="detail-card profile-list"><h2>Polls</h2><% if (!polls.length) { %><p class="muted">No polls yet.</p><% } %><% polls.forEach(poll => { %><a class="profile-item" href="/Polls"><strong><%= poll.title %></strong><small><%= formatDate(poll.createdAt) %></small></a><% }) %></section></main><%- include('partials/footer') %></body></html>